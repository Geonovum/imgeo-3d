 x="600" y="166"/></Array></mxGeometry></mxCell><mxCell id="s52" value="+address" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="s51"><mxGeometry x="0.9" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="s53" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="s51"><mxGeometry x="0.97" relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="s54" value="binnenvlakken (begrenzen in CityGML Room, LOD4)" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="1850" y="595" width="260" height="20" as="geometry"/></mxCell><mxCell id="s55" value="&lt;b&gt;Semantische begrenzingsvlakken (CityGML 2.0, module Building)&lt;/b&gt;&lt;br&gt;• _AbstractBuilding (en dus Building, BuildingPart en Pand) en BuildingInstallation hebben &lt;i&gt;boundedBy&lt;/i&gt; naar _BoundarySurface [0..*]; vlakken bestaan vanaf LOD2.&lt;br&gt;• Geometrie van een vlak: lod2/3/4MultiSurface. De lodXSolid van het gebouw verwijst met xlink:href naar dezelfde polygonen.&lt;br&gt;• Openingen (Window, Door) vanaf LOD3, via &lt;i&gt;opening&lt;/i&gt;; Door kan een adres hebben.&lt;br&gt;• Geometrie-eigenschappen staan hier als attributen; in de CityGML-UML zijn het associaties naar GML-types (gelijkwaardig)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="820" width="760" height="120" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
